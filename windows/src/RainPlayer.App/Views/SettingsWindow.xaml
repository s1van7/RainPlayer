<Window x:Class="RainPlayer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" Style="{StaticResource TitleText}" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="外观" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
                <TextBlock Text="主题" Style="{StaticResource SubText}" Margin="0,0,0,8" />
                <WrapPanel x:Name="ThemePanel" Margin="0,0,0,10" />

                <CheckBox x:Name="GlassBox" Content="毛玻璃效果"
                          Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,0,0,6" />
                <TextBlock Text="面板半透明，背景隐约透出来；关闭后更省显卡"
                           Style="{StaticResource SubText}" Margin="24,0,0,18" />

                <Border Style="{StaticResource Divider}" Margin="0,0,0,18" />

                <TextBlock Text="内容与评分" Style="{StaticResource SectionText}" Margin="0,0,0,12" />

                <CheckBox x:Name="AggregateBox" Content="聚合搜索（同时搜索所有服务器）"
                          Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,0,0,6" />
                <TextBlock Text="结果会标注来源服务器，点开自动切到那台服务器"
                           Style="{StaticResource SubText}" Margin="24,0,0,14" />

                <CheckBox x:Name="DailyBox" Content="首页每日推荐轮播"
                          Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,0,0,6" />
                <TextBlock Text="显示在「继续观看」上方，每天自动换一批"
                           Style="{StaticResource SubText}" Margin="24,0,0,14" />

                <CheckBox x:Name="DoubanBox" Content="豆瓣评分"
                          Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,0,0,6" />
                <TextBlock Text="通过第三方聚合接口获取；拿不到自动隐藏"
                           Style="{StaticResource SubText}" Margin="24,0,0,14" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TMDB API Key"
                               Style="{StaticResource SubText}" Margin="0,0,0,4" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="ResetTmdbButton" Content="恢复内置"
                            Style="{StaticResource GhostButton}" FontSize="11"
                            Padding="8,3" Margin="8,0,0,4" Click="OnResetTmdbClick" />
                </Grid>
                <TextBlock Text="已内置公共 Key，无需配置；想用自己的可在 themoviedb.org 申请后替换，清空则关闭 TMDB 评分"
                           Style="{StaticResource SubText}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBox x:Name="TmdbKeyBox" FontSize="13" Padding="10,7" Margin="0,0,0,20"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1" />

                <Border Style="{StaticResource Divider}" Margin="0,0,0,18" />

                <TextBlock Text="播放" Style="{StaticResource SectionText}" Margin="0,0,0,12" />

                <CheckBox x:Name="PassthroughBox" Content="音频直通（AC3 / EAC3 / DTS / TrueHD 原码输出）"
                          Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,0,0,6" />
                <TextBlock Text="开启后交给电视或功放解码；设备不支持时关掉，由播放器软解为 PCM"
                           Style="{StaticResource SubText}" Margin="24,0,0,14" />

                <CheckBox x:Name="HardwareBox" Content="硬件解码（D3D11VA）"
                          Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,0,0,6" />
                <TextBlock Text="4K / 8K 片源建议开启，关闭后完全靠 CPU 软解"
                           Style="{StaticResource SubText}" Margin="24,0,0,14" />

                <CheckBox x:Name="HdrBox" Content="HDR 直通"
                          Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,0,0,6" />
                <TextBlock Text="把片源色彩空间原样交给系统，需要在 Windows 设置里打开 HDR"
                           Style="{StaticResource SubText}" Margin="24,0,0,14" />

                <CheckBox x:Name="AutoNextBox" Content="自动连播下一集"
                          Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,0,0,6" />
                <TextBlock Text="当前集播完后自动接续同一季的下一集"
                           Style="{StaticResource SubText}" Margin="24,0,0,18" />

                <TextBlock Text="默认音量" Style="{StaticResource SubText}" Margin="0,0,0,6" />
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="240"
                        HorizontalAlignment="Left" Style="{StaticResource SeekSlider}" Margin="0,0,0,20" />

                <Border Style="{StaticResource Divider}" Margin="0,0,0,18" />

                <TextBlock Text="关于" Style="{StaticResource SectionText}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource SubText}" />
                    <TextBlock Grid.Column="1" x:Name="VersionText" FontSize="12.5"
                               Foreground="{StaticResource TextBrush}" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="服务器" Style="{StaticResource SubText}" />
                    <TextBlock Grid.Column="1" x:Name="ServerInfoText" FontSize="12.5"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="播放内核" Style="{StaticResource SubText}" />
                    <TextBlock Grid.Column="1" x:Name="MpvInfoText" FontSize="12.5"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="配置目录" Style="{StaticResource SubText}" />
                    <TextBlock Grid.Column="1" x:Name="ConfigPathText" FontSize="11.5"
                               Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" />
                </Grid>

                <Button Content="打开配置目录" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Click="OnOpenConfigClick" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}" Click="OnCancelClick" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
