<Window x:Class="RainPlayer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RainPlayer"
        Width="1280" Height="820"
        MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧导航 ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌行 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,20,18">
                    <Border Width="30" Height="30" CornerRadius="9" Background="#FFFFFF" ClipToBounds="True">
                        <Image Source="pack://siteoforigin:,,,/Assets/app-preview.png" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="RainPlayer" FontSize="15.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <!-- 主导航：文字颜色显式绑到按钮自身的 Foreground，
                     避免自定义模板里 ContentPresenter 不继承前景色导致「有框没字」 -->
                <StackPanel Grid.Row="1" Margin="12,0,12,10">
                    <RadioButton x:Name="HomeNav" Style="{StaticResource NavButton}" IsChecked="True"
                                 Margin="0,0,0,2" Checked="OnHomeNav">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M10,1.6 L18.4,8.6 L18.4,18 L12.6,18 L12.6,12.2 L7.4,12.2 L7.4,18 L1.6,18 L1.6,8.6 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="首页" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="LibrariesNav" Style="{StaticResource NavButton}"
                                 Margin="0,0,0,2" Checked="OnLibrariesNav">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M1.8,1.8 H8.2 V8.2 H1.8 Z M11.8,1.8 H18.2 V8.2 H11.8 Z M1.8,11.8 H8.2 V18.2 H1.8 Z M11.8,11.8 H18.2 V18.2 H11.8 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="媒体库" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 服务器 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="服务器" FontSize="11" Margin="22,10,22,8"
                               Foreground="{StaticResource FaintTextBrush}" />

                    <Button x:Name="ServerButton" Grid.Row="1" Style="{StaticResource GhostButton}"
                            Margin="12,0,12,0" Padding="10,9" VerticalAlignment="Top"
                            HorizontalContentAlignment="Stretch" Click="OnServerButtonClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                    Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                                <Grid>
                                    <TextBlock x:Name="ServerIconText" Text="R" FontSize="14" FontWeight="Bold"
                                               Foreground="Black" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image x:Name="ServerIconImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ServerText" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ServerSubText" Style="{StaticResource SubText}" FontSize="10"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="▾" Foreground="{StaticResource SubTextBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- 底部操作 -->
                <StackPanel Grid.Row="3" Margin="12,10,12,16">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />

                    <Button Style="{StaticResource NavItemButton}" Height="36" Click="OnSettingsClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M2,5 H18 M2,12 H18 M2,19 H18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" />
                            <TextBlock Text="设置" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemButton}" Height="36" Click="OnSignOutClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M9,2 H3.5 A1.5,1.5 0 0 0 2,3.5 V16.5 A1.5,1.5 0 0 0 3.5,18 H9 M13,6 L18,10.5 L13,15 M18,10.5 H7"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" />
                            <TextBlock Text="退出登录" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 右侧内容 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部栏 -->
            <Grid Grid.Row="0" Margin="26,18,26,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Content="← 返回" Style="{StaticResource GhostButton}"
                        Visibility="Collapsed" Margin="0,0,14,0" Click="OnBackClick" />

                <TextBlock x:Name="PageTitle" Grid.Column="1" Text="首页" Style="{StaticResource TitleText}"
                           VerticalAlignment="Center" />

                <Border Grid.Column="2" Width="260" Height="38" CornerRadius="19"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 VerticalContentAlignment="Center" Padding="16,0" FontSize="13.5"
                                 KeyDown="OnSearchKeyDown" />
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索影片、剧集…" IsHitTestVisible="False"
                                   Foreground="{StaticResource FaintTextBrush}" FontSize="13.5"
                                   VerticalAlignment="Center" Margin="17,0,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 内容区 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="26,4,26,28">
                    <StackPanel x:Name="ContentPanel" />
                </ScrollViewer>

                <Border x:Name="LoadingLayer" Background="#800E1014" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="正在加载…" Foreground="{StaticResource SubTextBrush}" FontSize="14"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="EmptyLayer" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText" Text="这里还没有内容" Foreground="{StaticResource SubTextBrush}"
                               FontSize="14" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
