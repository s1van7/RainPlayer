<Window x:Class="RainPlayer.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RainPlayer · 登录"
        Width="900" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        ResizeMode="CanMinimize">

    <Grid>
        <!-- 背景渐变 -->
        <Grid.Background>
            <RadialGradientBrush Center="0.2,0.1" GradientOrigin="0.2,0.1" RadiusX="1.1" RadiusY="1.2">
                <GradientStop Color="#1B2A4A" Offset="0" />
                <GradientStop Color="#0E1014" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="60,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- 左侧品牌区 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,60,0">
                <TextBlock Text="RainPlayer" FontSize="52" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Emby · Jellyfin · 飞牛影视" FontSize="16" Margin="0,10,0,0"
                           Foreground="{StaticResource SubTextBrush}" />
                <Border Height="1" Background="#22FFFFFF" Margin="0,28,0,28" />
                <StackPanel>
                    <TextBlock Text="4K / 8K · HDR10 / 杜比视界 · 杜比全景声直通"
                               FontSize="13.5" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="libmpv 内核，直链播放不转码"
                               FontSize="13.5" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="内置飞牛影视协议，无需另装客户端"
                               FontSize="13.5" Foreground="{StaticResource SubTextBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- 右侧登录卡片 -->
            <Border Grid.Column="1" Background="#CC16191F" CornerRadius="16" Padding="34"
                    VerticalAlignment="Center" BorderBrush="#22FFFFFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="连接服务器" Style="{StaticResource SectionText}" FontSize="19" Margin="0,0,0,22" />

                    <TextBlock Text="服务器类型" Style="{StaticResource SubText}" Margin="0,0,0,6" />
                    <ComboBox x:Name="KindBox" Style="{StaticResource AppComboBox}" Margin="0,0,0,16"
                              SelectionChanged="OnKindChanged" />

                    <TextBlock Text="服务器地址" Style="{StaticResource SubText}" Margin="0,0,0,6" />
                    <TextBox x:Name="UrlBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,16" />
                    <TextBlock x:Name="UrlHint" Style="{StaticResource SubText}" FontSize="11.5"
                               Foreground="{StaticResource FaintTextBrush}" Margin="0,-10,0,16" />

                    <TextBlock Text="用户名" Style="{StaticResource SubText}" Margin="0,0,0,6" />
                    <TextBox x:Name="UserBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,16" />

                    <TextBlock Text="密码" Style="{StaticResource SubText}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PassBox" Style="{StaticResource AppPasswordBox}" Margin="0,0,0,10" />

                    <CheckBox x:Name="RememberBox" Content="记住密码" IsChecked="True" Margin="0,0,0,14"
                              Foreground="{StaticResource SubTextBrush}" FontSize="12.5" />

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12.5"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" />

                    <Button x:Name="LoginButton" Content="登录" Style="{StaticResource PrimaryButton}"
                            Height="42" Click="OnLoginClick" />

                    <TextBlock x:Name="StatusText" Style="{StaticResource SubText}" Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
