<Window x:Class="RainPlayer.App.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mpv="clr-namespace:RainPlayer.Player;assembly=RainPlayer.Player"
        Title="RainPlayer"
        Width="1280" Height="720"
        MinWidth="640" MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        FontFamily="{StaticResource AppFont}"
        KeyDown="OnKeyDown">

    <Grid x:Name="RootGrid">
        <!-- 视频输出（mpv 渲染到这里） -->
        <mpv:MpvVideoHost x:Name="VideoHost" />

        <!-- 顶部标题栏：独立 Popup 才能盖在视频上（airspace） -->
        <Popup x:Name="TopBar" PlacementTarget="{Binding ElementName=VideoHost}" Placement="Relative"
               StaysOpen="True" AllowsTransparency="True" IsHitTestVisible="True">
            <Border x:Name="TopBarBorder" Background="#D90B0D11" CornerRadius="0,0,10,10">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="15.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="White" />
                        <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#B9C0CE" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TechText" FontSize="11.5" Foreground="#8A93A5"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="✕" Style="{StaticResource GhostButton}" Width="36" Height="32"
                                Padding="0" Click="OnCloseClick" ToolTip="关闭 (Esc)" />
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- 底部控制条 -->
        <Popup x:Name="BottomBar" PlacementTarget="{Binding ElementName=VideoHost}" Placement="Relative"
               StaysOpen="True" AllowsTransparency="True" IsHitTestVisible="True">
            <Border x:Name="BottomBarBorder" Background="#D90B0D11" CornerRadius="10,10,0,0" Padding="22,12,22,14">
                <StackPanel>
                    <!-- 进度 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PositionText" Grid.Column="0" Text="00:00" FontSize="12"
                                   Foreground="#D5DBE6" VerticalAlignment="Center" Width="56" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource SeekSlider}"
                                Minimum="0" Maximum="1" Margin="6,0,6,0"
                                Thumb.DragStarted="OnSeekStart" Thumb.DragCompleted="OnSeekEnd"
                                ValueChanged="OnSeekValueChanged" />
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" FontSize="12"
                                   Foreground="#8A93A5" VerticalAlignment="Center" Width="56"
                                   TextAlignment="Right" />
                    </Grid>

                    <!-- 按钮行 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PlayButton" Content="▶" Style="{StaticResource GhostButton}"
                                    Width="40" Height="34" Padding="0" FontSize="14"
                                    Click="OnPlayPauseClick" ToolTip="播放 / 暂停 (空格)" />
                            <Button Content="⏮ 10s" Style="{StaticResource GhostButton}" Height="34"
                                    Margin="8,0,0,0" FontSize="12" Click="OnBack10Click" ToolTip="后退 10 秒 (←)" />
                            <Button Content="10s ⏭" Style="{StaticResource GhostButton}" Height="34"
                                    Margin="6,0,0,0" FontSize="12" Click="OnForward10Click" ToolTip="前进 10 秒 (→)" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="AudioButton" Content="音轨" Style="{StaticResource GhostButton}"
                                    Height="34" FontSize="12" Click="OnAudioClick" Margin="0,0,6,0" />
                            <Button x:Name="SubtitleButton" Content="字幕" Style="{StaticResource GhostButton}"
                                    Height="34" FontSize="12" Click="OnSubtitleClick" Margin="0,0,6,0" />

                            <TextBlock Text="🔊" FontSize="14" Foreground="#D5DBE6" VerticalAlignment="Center"
                                       Margin="8,0,6,0" />
                            <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="80"
                                    Style="{StaticResource SeekSlider}" VerticalAlignment="Center"
                                    ValueChanged="OnVolumeChanged" />

                            <Button Content="⛶" Style="{StaticResource GhostButton}" Width="38" Height="34"
                                    Padding="0" Margin="12,0,0,0" FontSize="14"
                                    Click="OnFullscreenClick" ToolTip="全屏 (F)" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 起播提示 -->
        <StackPanel x:Name="StatusLayer" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsHitTestVisible="False">
            <TextBlock x:Name="StatusText" Text="正在准备播放…" Foreground="#C9D0DC" FontSize="14"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 错误提示 -->
        <Border x:Name="ErrorLayer" Background="#E60E1014" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <TextBlock Text="播放失败" FontSize="20" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText" Foreground="#B9C0CE" FontSize="13" TextWrapping="Wrap"
                           Margin="0,12,0,0" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Content="重试" Style="{StaticResource PrimaryButton}" Click="OnRetryClick" />
                    <Button Content="转码播放" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Click="OnTranscodeClick" />
                    <Button Content="关闭" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Click="OnCloseClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
