<UserControl x:Class="RainPlayer.App.Controls.PosterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="168" Margin="0,0,14,0" Cursor="Hand">

    <StackPanel>
        <Border x:Name="CardRoot" Style="{StaticResource PosterCard}" Height="240" ClipToBounds="True">
            <Grid>
                <!-- 占位底色 -->
                <Border Background="#232833" CornerRadius="10" />

                <Image x:Name="Poster" Stretch="UniformToFill" />

                <!-- 底部渐变，压住图片下沿 -->
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.55" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#CC000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 观看进度 -->
                <Border x:Name="ProgressBar" Height="3" VerticalAlignment="Bottom" Background="#40FFFFFF"
                        CornerRadius="0,0,10,10">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                            CornerRadius="0,0,0,10" />
                </Border>

                <!-- 已看完角标 -->
                <Border x:Name="WatchedBadge" Background="#CC0E1014" CornerRadius="6" Padding="7,3"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                        Visibility="Collapsed">
                    <TextBlock Text="已看完" FontSize="10.5" Foreground="{StaticResource SubTextBrush}" />
                </Border>

                <!-- 悬停播放提示 -->
                <Border x:Name="HoverLayer" Background="#40000000" CornerRadius="10" Visibility="Collapsed">
                    <Grid>
                        <Ellipse Width="48" Height="48" Fill="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Path Data="M 20,16 L 20,32 L 33,24 Z" Fill="#16191F"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Medium" Margin="2,9,2,0"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="SubText" FontSize="11.5" Margin="2,3,2,0"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{StaticResource SubTextBrush}" />
    </StackPanel>
</UserControl>
