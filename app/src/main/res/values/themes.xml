<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Rain" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rain_bg</item>
        <item name="android:statusBarColor">@color/rain_bg</item>
        <item name="android:navigationBarColor">@color/rain_bg</item>
        <item name="android:colorAccent">@color/rain_accent</item>
    </style>

    <style name="Theme.Rain.Tv" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rain_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.Rain.Player" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
